datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum WebsiteStatus {
  DRAFT
  DEPLOYING
  LIVE
  SUSPENDED
  FAILED
  DELETED
}

enum DeploymentStatus {
  PENDING
  QUEUED
  VALIDATING
  EXTRACTING
  DEPLOYING
  LIVE
  FAILED
  ROLLED_BACK
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String?
  role         UserRole      @default(USER)
  websites     Website[]
  activityLogs ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  websites    Website[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
}

model Website {
  id                 String        @id @default(cuid())
  name               String
  slug               String        @unique
  subdomain          String        @unique
  description        String?
  imageUrl           String?
  status             WebsiteStatus @default(DRAFT)
  activeDeploymentId String?
  storagePath        String?
  previewToken       String?
  ownerId            String?
  owner              User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  categoryId         String?
  category           Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  deployments        Deployment[]
  domains            SiteDomain[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([subdomain])
  @@index([slug])
}

model Deployment {
  id           String           @id @default(cuid())
  websiteId    String
  website      Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  version      Int
  status       DeploymentStatus @default(PENDING)
  storagePath  String?
  fileSize     Int?
  filesCount   Int?
  changeLog    String?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([websiteId, version])
  @@index([websiteId])
  @@index([status])
}

model SiteDomain {
  id        String   @id @default(cuid())
  websiteId String
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  hostname  String   @unique
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([websiteId])
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  content   Json
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model HomepageSection {
  id         String   @id @default(cuid())
  sectionKey String   @unique
  title      String
  content    Json
  order      Int      @default(0)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
  @@index([sectionKey])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@index([key])
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
}

model Menu {
  id        String   @id @default(cuid())
  name      String   @unique
  items     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
