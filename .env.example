# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://sitenest.com
BASE_DOMAIN=sitenest.com
WEBSITE_BASE_DOMAIN=sitenestusercontent.com
NEXT_PUBLIC_BASE_DOMAIN=sitenest.com
NEXT_PUBLIC_WEBSITE_BASE_DOMAIN=sitenestusercontent.com

# PostgreSQL Database
DATABASE_URL="postgresql://sitenest:password@localhost:5432/sitenest"

# Authentication
AUTH_SECRET=your-long-random-secret-at-least-32-characters

# Redis
REDIS_URL=redis://localhost:6379
REDIS_SOCKET=/tmp/redis.sock

# Storage
UPLOAD_DIR=/var/www/sitenest/storage/uploads
WEBSITE_DIR=/var/www/sitenest/storage/websites
TEMP_DIR=/var/www/sitenest/storage/temporary

# DNS Provider / Cloudflare
DNS_PROVIDER_API_TOKEN=your-dns-api-token
